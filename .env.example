# Mavis Digital Campus v0.8.6.9
# Copy this file to .env. Never share your .env file or API keys.

# Gemini
GEMINI_API_KEY=PASTE_YOUR_GEMINI_KEY_HERE
GEMINI_MODEL=gemini-3.5-flash-lite

# OpenAI
OPENAI_API_KEY=PASTE_YOUR_OPENAI_KEY_HERE
OPENAI_MODEL=gpt-5.6-terra

# Role routing
# v0.7.4 does NOT automatically fall back from one provider to another.
CHIEF_PROVIDER=gemini
RESEARCH_PROVIDER=gemini
PROGRAMS_PROVIDER=openai
CARETAKER_PROVIDER=gemini

# Weather & Seasons (v0.8.6.9)
# KWFLATT11 is preconfigured as the primary personal weather station.
# Weather Underground/The Weather Company requires an API key for direct PWS readings.
# Leave blank to use Open-Meteo current conditions as a clearly labeled fallback plus forecast.
WEATHER_UNDERGROUND_API_KEY=

# Google Calendar (read-only primary calendar; Desktop OAuth client)
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
